{
  "name": "github-profile-pet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:pet-engine": "node --test --experimental-strip-types tests/pet-engine/*.test.ts",
    "test:all": "node --test --experimental-strip-types tests/unit/*.test.ts tests/pet-engine/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 --experimental-strip-types tests/integration/*.test.ts",
    "render:svg": "node --experimental-strip-types scripts/render-svg.ts",
    "simulate:pet": "node --experimental-strip-types scripts/simulate-pet.ts",
    "publish:pet": "node --experimental-strip-types scripts/publish-pet.ts",
    "process:inbox": "node --experimental-strip-types scripts/process-inbox.ts",
    "readme:menu:generate": "node --experimental-strip-types scripts/manage-readme-menu.ts generate",
    "readme:menu:install": "node --experimental-strip-types scripts/manage-readme-menu.ts install",
    "readme:menu:uninstall": "node --experimental-strip-types scripts/manage-readme-menu.ts uninstall",
    "readme:menu:check": "node --experimental-strip-types scripts/manage-readme-menu.ts check",
    "migrate": "node --experimental-strip-types scripts/migrate.ts up",
    "migrate:down": "node --experimental-strip-types scripts/migrate.ts down"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^16.15.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
