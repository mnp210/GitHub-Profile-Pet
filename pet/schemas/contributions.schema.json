{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/github-profile-pet/schemas/contributions.schema.json",
  "title": "ContributionLedgerDocument",
  "type": "object",
  "required": [
    "schemaVersion",
    "generation",
    "dailyAccruedXp",
    "slices",
    "monthlyHistoricalSummary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "ownerDatabaseId": {
      "type": "integer",
      "minimum": 1
    },
    "ownerLogin": {
      "type": "string",
      "minLength": 1
    },
    "installationBaseline": {
      "type": "object",
      "required": ["completed", "installedAt", "baselineDateUtc", "initialCounts"],
      "properties": {
        "completed": { "type": "boolean" },
        "installedAt": { "type": "string", "format": "date-time" },
        "baselineDateUtc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "initialCounts": {
          "type": "object",
          "required": ["yesterday", "today"],
          "properties": {
            "yesterday": { "type": "integer", "minimum": 0 },
            "today": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dailyHwm": {
      "type": "object",
      "description": "Peak aggregate public contribution count observed per UTC date",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "dailyRewardOrdinal": {
      "type": "object",
      "description": "Monotonic counter of post-installation discovered reward increments per UTC date",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "lastSyncReceipt": {
      "type": "object",
      "required": ["timestamp", "status", "incrementsProcessed"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "enum": ["success", "noop", "provider_failure", "rate_limited"]
        },
        "incrementsProcessed": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dailyAccruedXp": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 300
      }
    },
    "hourlyIncrementUsage": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
      }
    },
    "hourlySliceUsage": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "monotonicPublicHwm": {
      "type": "integer",
      "minimum": 0
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sliceId",
          "syncDate",
          "discoveredAt",
          "units",
          "status",
          "rewardedXp",
          "rewardedSatiety",
          "expiryAt"
        ],
        "properties": {
          "sliceId": { "type": "string" },
          "syncDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "dailyOrdinal": { "type": "integer", "minimum": 1 },
          "discoveredAt": { "type": "string", "format": "date-time" },
          "units": { "type": "integer", "minimum": 1 },
          "status": {
            "type": "string",
            "enum": ["rewarded", "forfeited", "pending", "expired"]
          },
          "rewardedXp": { "type": "integer", "minimum": 0 },
          "rewardedSatiety": { "type": "integer", "minimum": 0 },
          "expiryAt": { "type": "string", "format": "date-time" },
          "evaluatedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "forfeitureReason": {
            "type": "string",
            "enum": ["daily_cap_exhausted", "whole_increment_overflow"]
          }
        },
        "additionalProperties": false
      }
    },
    "monthlyHistoricalSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "month",
          "totalObservedUnits",
          "rewardedUnits",
          "forfeitedUnits",
          "expiredUnits",
          "rewardedXp"
        ],
        "properties": {
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "totalObservedUnits": { "type": "integer", "minimum": 0 },
          "rewardedUnits": { "type": "integer", "minimum": 0 },
          "forfeitedUnits": { "type": "integer", "minimum": 0 },
          "expiredUnits": { "type": "integer", "minimum": 0 },
          "rewardedXp": { "type": "integer", "minimum": 0 },
          "rewardedSatiety": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
