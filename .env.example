# ==============================================================================
# GitHub Profile Pet - Environment Variables Template
# Copy this file to .env.local for local development.
# Never commit real credentials, production secrets, or .env.local to Git.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL 16+ Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/github_profile_pet
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/github_profile_pet_test

# GitHub App OAuth 2.0 Credentials (User-to-Server Flow)
# Register a GitHub App at: https://github.com/settings/apps/new
# Callback URL: http://localhost:3000/api/auth/callback (or production domain)
GITHUB_CLIENT_ID=your_github_app_client_id_here
GITHUB_CLIENT_SECRET=your_github_app_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Token Encryption Key (Authenticated AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hexadecimal characters (256 bits).
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session Configuration
# Default: 2592000 seconds (30 days)
SESSION_MAX_AGE_SECONDS=2592000
